# Modèle de configuration Nginx : ${API_URL} est remplacé au démarrage
# du conteneur par la valeur de la variable d'environnement API_URL.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Les appels /api/... sont transmis à l'API Spring Boot.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fichiers JS/CSS générés par Vite : leur nom change à chaque build,
    # le navigateur peut donc les garder en cache un an.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Toutes les autres URL (/missions, /login...) renvoient index.html :
    # c'est React Router qui affiche la bonne page.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}